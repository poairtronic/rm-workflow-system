# ==============================================================================
# Backend Environment Configuration Template
# ==============================================================================
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rm_workflow_db
DATABASE_URL_DIRECT=postgresql://postgres:postgres@localhost:5432/rm_workflow_db
JWT_SECRET=your_development_jwt_secret_min_32_characters
JWT_EXPIRATION=7d
SEED_DEFAULT_PASSWORD=your_seed_default_password_here
FRONTEND_URL=http://localhost:5173

# Database & Sync
TYPEORM_SYNC=
ECR_DATABASE_URL=
DB_HOST=
DB_PORT=
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Supabase Storage Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_SERVICE_KEY=
SUPABASE_STORAGE_BUCKET=rmrit-documents

# Dedicated RMRIT Gmail API Configuration
# GMAIL_CLIENT_ID=your_oauth2_client_id.apps.googleusercontent.com
# GMAIL_CLIENT_SECRET=your_oauth2_client_secret
# GMAIL_REFRESH_TOKEN=your_oauth2_refresh_token
# GMAIL_SENDER_EMAIL=your_authorized_gmail_sender@example.com
# GMAIL_REDIRECT_URI=https://developers.google.com/oauthplayground

# Email Worker
EMAIL_PROVIDER_TYPE=
EMAIL_WORKER_ENABLED=
EMAIL_WORKER_BATCH_SIZE=
EMAIL_WORKER_POLL_INTERVAL_MS=
EMAIL_WORKER_RETRY_BACKOFF_SECONDS=
EMAIL_RETRY_MAX_DELAY=
EMAIL_WORKER_STALE_THRESHOLD_SECONDS=
EMAIL_WORKER_SHUTDOWN_TIMEOUT_MS=

# Neon Serverless Realtime & Data API Configuration
NEON_REALTIME_URL=https://<branch>-neonrealtimesocket.compute.<region>.aws.neon.tech/
NEON_DATA_API_URL=https://<endpoint>.apirest.<region>.aws.neon.tech/<dbname>/rest/v1
# NEON_REALTIME_SECRET=your_neon_realtime_branch_secret

# ECR Application Bridge
ECR_API_URL=https://error-correction-application.onrender.com
ECR_INTERNAL_SECRET=vsmart_ecr_bridge_2026_secure

# RM Internal Secret (used by external apps like ECR & MERC)
RM_INTERNAL_SECRET=vsmart_ecr_bridge_2026_secure

# MERC Application Bridge
MERC_API_URL=
MERC_INTERNAL_SECRET=

# Cron Schedules
CONSUMABLE_SLA_CRON_SCHEDULE=
DC_SLA_CRON_SCHEDULE=
MERC_SYNC_CRON_SCHEDULE=
MSL_CRON_SCHEDULE=
ENABLE_MERC_CRON=

# Company DC Header
COMPANY_NAME=
COMPANY_ADDRESS=
COMPANY_GSTIN=
COMPANY_PHONE=
COMPANY_EMAIL=
COMPANY_WEBSITE=
