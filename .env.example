# ==============================================================================
# RMRIT Environment Configuration Template
# ==============================================================================
# Copy this file to .env and set your local credentials.
# NEVER commit actual secrets or production credentials to version control.

# Application Environment (development | test | production)
NODE_ENV=development

# Backend Server Port
PORT=3000

# Backend PostgreSQL Database Connection (Local or Neon / Supabase)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rm_workflow_db

# JSON Web Token Secret & Expiration
JWT_SECRET=your_development_jwt_secret_min_32_characters
JWT_EXPIRATION=7d

# Cross-Origin Resource Sharing (CORS) Allowed Frontend URL
FRONTEND_URL=http://localhost:5173

# Frontend API Target (Used by Vite / Client Services)
VITE_BACKEND_URL=http://localhost:3000

# Optional: Email Service Configuration (Reserved for Notifications Module)
# SMTP_HOST=smtp.mailgun.org
# SMTP_PORT=587
# SMTP_USER=postmaster@yourdomain.com
# SMTP_PASSWORD=your_smtp_password
# SMTP_FROM="RMRIT Alerts <no-reply@yourdomain.com>"
