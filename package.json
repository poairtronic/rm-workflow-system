{
  "name": "rm-workflow-system",
  "version": "1.0.0",
  "private": true,
  "description": "Internal manufacturing raw-material workflow & traceability application",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "npm --prefix backend run start:dev",
    "dev:backend": "npm --prefix backend run start:dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces",
    "lint": "npm run lint --workspaces",
    "format": "npx prettier --write \"**/*.{ts,tsx,js,json,md,css}\"",
    "format:check": "npx prettier --check \"**/*.{ts,tsx,js,json,md,css}\""
  },
  "keywords": [
    "rm-workflow",
    "manufacturing",
    "traceability",
    "nestjs",
    "react"
  ],
  "author": "",
  "license": "UNLICENSED",
  "devDependencies": {
    "prettier": "^3.9.6"
  }
}
